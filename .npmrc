# Pin every dep to an exact version on install.
# Exact pinning happens on first `pnpm install`; lockfile is committed.
save-exact=true

# pnpm 10 blocks lifecycle scripts (postinstall, prepare, etc.) by default.
# Only packages in onlyBuiltDependencies (package.json) may run native builds.
# Keep that allowlist tight (ADR-0004 Layer-1).

# One Node, not a floor: better-sqlite3 is built for a single ABI, so pnpm must
# refuse a wrong Node here rather than let it fail later inside a database call.
engine-strict=true
