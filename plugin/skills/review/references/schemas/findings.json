{
  "type": "object",
  "properties": {
    "codeReviewFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": ["string", "number"]
          },
          "quote": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": ["CONFIRMED", "PARTIAL", "DECLINED", "UNVERIFIABLE"]
          },
          "citationAccurate": {
            "type": "boolean"
          },
          "evidenceBasis": {
            "type": "string",
            "enum": [
              "file-content",
              "absence-of-file",
              "commit-message",
              "identifier-name",
              "comment",
              "none"
            ]
          },
          "remedyScope": {
            "type": "string",
            "enum": ["single-site", "all-sites-verified", "sites-differ"]
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": ["string", "number"]
                },
                "remedySafe": {
                  "type": "boolean"
                },
                "remedyNote": {
                  "type": "string"
                }
              },
              "required": ["file", "line", "remedySafe", "remedyNote"],
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string",
            "enum": ["introduced", "pre-existing", "undetermined"]
          },
          "kind": {
            "type": "string",
            "enum": ["defect", "business-decision", "external-confirmation"]
          },
          "severity": {
            "type": "string",
            "enum": ["blocking", "major", "minor"]
          },
          "severityRationale": {
            "type": "string"
          },
          "probes": {
            "type": "object",
            "properties": {
              "guard": {
                "type": "string"
              },
              "reachability": {
                "type": "string"
              },
              "remedy": {
                "type": "string"
              },
              "callers": {
                "type": "string"
              },
              "scope": {
                "type": "string"
              }
            },
            "required": ["guard", "reachability", "remedy", "callers", "scope"],
            "additionalProperties": false
          },
          "correctedWording": {
            "type": "string"
          }
        },
        "required": [
          "claim",
          "file",
          "line",
          "quote",
          "verdict",
          "citationAccurate",
          "evidenceBasis",
          "remedyScope",
          "sites",
          "scope",
          "kind",
          "severity",
          "severityRationale",
          "probes",
          "correctedWording"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "description": "Rule: verdict CONFIRMED needs evidenceBasis file-content or absence-of-file (an observation of files); otherwise use PARTIAL, DECLINED or UNVERIFIABLE.",
            "if": {
              "required": ["verdict"],
              "properties": {
                "verdict": {
                  "const": "CONFIRMED"
                }
              }
            },
            "then": {
              "required": ["evidenceBasis"],
              "properties": {
                "evidenceBasis": {
                  "enum": ["file-content", "absence-of-file"]
                }
              }
            }
          },
          {
            "description": "Rule: remedyScope all-sites-verified requires every sites[].remedySafe to be true; use sites-differ when any site is unsafe.",
            "if": {
              "required": ["remedyScope"],
              "properties": {
                "remedyScope": {
                  "const": "all-sites-verified"
                }
              }
            },
            "then": {
              "required": ["sites"],
              "properties": {
                "sites": {
                  "items": {
                    "required": ["remedySafe"],
                    "properties": {
                      "remedySafe": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "description": "Rule: remedyScope single-site allows at most one entry in sites; check the remedy at each location and use all-sites-verified or sites-differ.",
            "if": {
              "required": ["remedyScope"],
              "properties": {
                "remedyScope": {
                  "const": "single-site"
                }
              }
            },
            "then": {
              "required": ["sites"],
              "properties": {
                "sites": {
                  "maxItems": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": ["codeReviewFindings"],
  "additionalProperties": false,
  "title": "codeReviewFindings"
}
