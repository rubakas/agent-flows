# ─── Layer-0 key isolation (ADR-0004) ───────────────────────────────────────
# OPENAI_API_KEY is used ONLY by the LiteLLM container, never by agent-flows itself.
# The agent-flows process must only ever see LITELLM_VIRTUAL_KEY, never a real
# provider key. Presence of OPENAI_API_KEY or ANTHROPIC_API_KEY in the agent-flows
# process env is treated as a misconfiguration and will throw at startup.
OPENAI_API_KEY=

# LiteLLM proxy credentials
LITELLM_MASTER_KEY=
# Revocable, budget-scoped virtual key — the only key agent-flows is allowed to hold.
LITELLM_VIRTUAL_KEY=
LITELLM_BASE_URL=http://localhost:4000/v1

# ─── GitHub ──────────────────────────────────────────────────────────────────
GH_TOKEN=

# ─── Database ────────────────────────────────────────────────────────────────
AGENT_FLOWS_DB_PATH=./agent-flows.sqlite
