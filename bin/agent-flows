#!/usr/bin/env bash
# Launch the agent-flows CLI under Node 22 regardless of the ambient node.
# better-sqlite3 is built for Node 22 (NODE_MODULE_VERSION 127); the host's
# default node is 20, which fails on an ABI mismatch. Force 22 here.
set -euo pipefail
# Capture the invocation directory before cd changes it; every verb that
# targets a project (serve, install, list, validate) uses cwd as the default
# project directory, and AGENT_FLOWS_PROJECT_DIR overrides that.
# This is where FR-003's single targeting rule is enforced at the boundary:
# an explicitly set variable wins; otherwise the project is wherever the user
# ran the command from.
AGENT_FLOWS_PROJECT_DIR="${AGENT_FLOWS_PROJECT_DIR:-$PWD}"
export AGENT_FLOWS_PROJECT_DIR
# Resolve through symlinks: the command is meant to be installed on PATH
# (a link in ~/.local/bin or a pnpm global bin), and the repository root must
# be computed from the real script location, not from the link's parent.
# readlink -f is not available on stock macOS, so we loop manually.
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
cd "$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
nvm use 22 >/dev/null 2>&1 || true
exec ./node_modules/.bin/tsx src/cli.ts "$@"
