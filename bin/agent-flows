#!/usr/bin/env node
// The installed agent-flows command (spec 038 D2, FR-002, FR-003).
//
// It runs the compiled CLI under the ambient node: no transpiler at runtime and
// no nvm sourcing, so it works from a global install with no dev dependencies.
// The Node requirement in package.json's engines.node is enforced here instead.
// It is a pin AND a floor. The major is a pin: better-sqlite3 is built for one
// Node ABI, and any other major fails deep inside a database call with an
// unreadable dlopen error — Node 24 is newer and equally unable to load the
// addon. Inside that major the floor is a security one (spec 048): the ABI does
// not change between releases of a line, so only the fixed releases are accepted.
//
// AI CLI harnesses spawn the registered MCP command with their own PATH, which
// is usually the machine's default node and may be the wrong major or an
// unpatched release. Refusing there would make the command unreachable from
// every harness, so when the running node does not satisfy the requirement this
// script looks for a working interpreter and re-execs itself under it, silently.
// It only refuses when it finds none.
//
// "Working" is proved by loading better-sqlite3, not by a version number: the
// version is necessary but not sufficient — a node of the right release that did
// not install these dependencies can still fail to open a database, and `serve`,
// the daemon every harness talks to, would then fail at its first query.
//
// The project directory is not captured here: this script never changes
// directory, so process.cwd() in the CLI is already the invocation directory
// and resolveProjectDir() falls back to it (AGENT_FLOWS_PROJECT_DIR still wins).

import { execFileSync, spawnSync } from "node:child_process";
import { existsSync, readdirSync, readFileSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { delimiter, dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const REEXEC_MARKER = "AGENT_FLOWS_NODE_REEXEC";

// Walk up to the package root rather than assuming a fixed depth: the command
// is reached through a symlink on PATH, and node resolves import.meta.url to
// the real file, so the walk starts inside the real package.
//
// This deliberately duplicates src/packageRoot.ts: the launcher runs before a
// build exists (and under a node that may not be able to load this package at
// all), so it cannot import the compiled helper. Do not "fix" it by importing.
let root = dirname(fileURLToPath(import.meta.url));
while (!existsSync(join(root, "package.json"))) {
  const parent = dirname(root);
  if (parent === root) {
    process.stderr.write(
      "agent-flows: could not locate the package root (no package.json above bin/).\n"
    );
    process.exit(1);
  }
  root = parent;
}

// The one place the version is written is package.json's engines.node, which
// this script has just located. It cannot import src/nodeVersion.ts: it runs
// before a build exists and under a node that may not be able to load this
// package at all, so the expression and the error text below are a deliberate
// copy of that module's (a test holds the two together).
const PIN = readPin();

function readPin() {
  let declared;
  try {
    declared = JSON.parse(readFileSync(join(root, "package.json"), "utf8"))?.engines?.node;
  } catch {
    // Fall through: an unreadable package.json is reported by the missing-CLI
    // check below far more usefully than by a version error here.
  }
  if (declared === undefined) {
    process.stderr.write("agent-flows: package.json declares no usable engines.node pin.\n");
    process.exit(1);
  }
  const match = /^\^(\d+)\.(\d+)\.(\d+)$/u.exec(String(declared));
  if (match === null) {
    process.stderr.write(
      `agent-flows: engines.node must be "^MAJOR.MINOR.PATCH" \u2014 one major with a security floor inside it (e.g. "^22.23.4") \u2014 got "${String(declared)}".\n`
    );
    process.exit(1);
  }
  const [major, minor, patch] = [Number(match[1]), Number(match[2]), Number(match[3])];
  const floor = `${String(major)}.${String(minor)}.${String(patch)}`;
  return { major, minor, patch, floor, requirement: `Node ${String(major)} at or above ${floor}` };
}

/** Whether a version is the pinned major and at or above the floor. */
function satisfies(version) {
  const match = /^v?(\d+)\.(\d+)\.(\d+)/u.exec(String(version ?? "").trim());
  if (match === null) return false;
  const [major, minor, patch] = [Number(match[1]), Number(match[2]), Number(match[3])];
  if (major !== PIN.major) return false;
  return minor > PIN.minor || (minor === PIN.minor && patch >= PIN.patch);
}

const running = process.versions.node;
if (!satisfies(running)) {
  reExecOrRefuse();
}

/** The full version a node binary reports, or undefined if it is not usable. */
function probeVersion(binary) {
  try {
    const reported = execFileSync(binary, ["-p", "process.versions.node"], {
      encoding: "utf8",
      timeout: 5_000,
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
    return /^\d+\.\d+\.\d+/u.test(reported) ? reported : undefined;
  } catch {
    // A missing file, a non-executable, a hung binary or anything that is not
    // node at all: all of them simply mean "not a candidate".
    return undefined;
  }
}

/**
 * Whether a candidate interpreter can actually run this package, and the version
 * it reported — the refusal message needs both, and probing is a subprocess, so
 * it happens once.
 *
 * The verdict is "ok", "version" (the wrong major, below the floor, or not a
 * node at all) or "native" (a satisfying version, but it cannot load the
 * compiled database module). A version number is not evidence: better-sqlite3
 * is compiled for whichever node installed it, so a Node 24 install passes a
 * naive floor and still fails to dlopen a binary built for Node 22. Loading the
 * module is the only evidence there is.
 */
function qualify(binary) {
  const version = probeVersion(binary);
  if (version === undefined || !satisfies(version)) return { verdict: "version", version };
  return { verdict: loadsNativeModule(binary) ? "ok" : "native", version };
}

/** True when `binary` can open a database with the package's better-sqlite3. */
function loadsNativeModule(binary) {
  const modulePath = join(root, "node_modules", "better-sqlite3");
  // No local copy of the module (a different install layout, or a package
  // whose dependencies live elsewhere) is not proof of a broken interpreter —
  // there is nothing to probe, so the version check stands on its own.
  if (!existsSync(modulePath)) return true;
  try {
    // Requiring the module is not enough: the addon is dlopened lazily, on the
    // first database, so the probe has to open one.
    execFileSync(
      binary,
      ["-e", `new (require(${JSON.stringify(modulePath)}))(":memory:").close()`],
      { timeout: 5_000, stdio: "ignore" }
    );
    return true;
  } catch {
    return false;
  }
}

/** Resolve a path for identity comparison, tolerating a missing file. */
function resolved(path) {
  try {
    return realpathSync(path);
  } catch {
    return path;
  }
}

/** The first node on PATH other than the running one that qualifies. */
function fromPath(rejected) {
  const self = resolved(process.execPath);
  for (const entry of (process.env.PATH ?? "").split(delimiter)) {
    if (entry === "") continue;
    const candidate = join(entry, "node");
    if (!existsSync(candidate) || resolved(candidate) === self) continue;
    if (accept(candidate, rejected)) return candidate;
  }
  return undefined;
}

/**
 * Qualify a candidate, recording why it was passed over when the refusal can use
 * it: `native` when only the module load failed, `belowFloor` when it is the
 * pinned major but a release older than the security floor.
 */
function accept(candidate, rejected) {
  const { verdict, version } = qualify(candidate);
  if (verdict === "native") rejected.native.push(candidate);
  if (
    verdict === "version" &&
    version !== undefined &&
    version.startsWith(`${String(PIN.major)}.`)
  ) {
    rejected.belowFloor.push(candidate);
  }
  return verdict === "ok";
}

/**
 * The first nvm-installed node that satisfies the pin and qualifies.
 *
 * Only the pinned major is considered — anything else cannot load the addon
 * whatever its version number says; releases below the floor are probed so the
 * refusal can name them, and passed over. Newest first, since that is the most
 * likely to be the one that installed the dependencies and the safest release;
 * with the native-module probe deciding, the order is an optimisation, not a
 * correctness argument.
 */
function fromNvm(rejected) {
  const versionsDir = join(process.env.NVM_DIR ?? join(homedir(), ".nvm"), "versions", "node");
  if (!existsSync(versionsDir)) return undefined;
  const parse = (name) => name.replace(/^v/u, "").split(".").map(Number);
  const entries = readdirSync(versionsDir)
    .filter((name) => /^v\d+\.\d+\.\d+$/u.test(name))
    .map(parse)
    .filter(([entryMajor]) => entryMajor === PIN.major)
    .sort((a, b) => b[1] - a[1] || b[2] - a[2]);
  for (const version of entries) {
    const candidate = join(versionsDir, `v${version.join(".")}`, "bin", "node");
    if (existsSync(candidate) && accept(candidate, rejected)) return candidate;
  }
  return undefined;
}

/**
 * The interpreter AGENT_FLOWS_NODE names, or an exit.
 *
 * An explicit override that is wrong must be loud: falling through to the
 * search would hide a broken configuration behind a working run.
 */
function overrideInterpreter(override) {
  const { verdict, version } = qualify(override);
  if (verdict === "ok") return override;
  const reason =
    verdict === "native"
      ? `it is Node ${String(version)}, but it cannot load this package's better-sqlite3 (built for a different Node ABI)`
      : `it is not ${PIN.requirement}${version === undefined ? "" : ` (it reports Node ${version})`}`;
  process.stderr.write(
    `agent-flows: AGENT_FLOWS_NODE points at ${override}, but ${reason}.\n` +
      `Point AGENT_FLOWS_NODE at a Node ${String(PIN.major)} binary at or above ${PIN.floor} that can load the module, or unset it.\n`
  );
  process.exit(1);
}

/**
 * The first interpreter on this machine that can run the package, or undefined.
 *
 * Candidates that were passed over for a reason the refusal can state — below the
 * floor, or unable to load the database module — are recorded on `rejected`, so
 * it can say that rather than "none found".
 */
function findInterpreter(rejected) {
  return (
    fromPath(rejected) ??
    fromNvm(rejected) ??
    ["/opt/homebrew/bin/node", "/usr/local/bin/node"].find((path) =>
      existsSync(path) ? accept(path, rejected) : false
    )
  );
}

/** Print why this node cannot run the package, and what was looked at, then exit. */
function refuse(rejected) {
  const nvmDir = process.env.NVM_DIR ?? join(homedir(), ".nvm");
  process.stderr.write(
    `agent-flows: ${PIN.requirement} is required (${PIN.floor} is the security floor), but this is ${running}.\n` +
      (rejected.belowFloor.length === 0
        ? ""
        : `Found Node ${String(PIN.major)} interpreters below the floor: ${rejected.belowFloor.join(", ")}.\n`) +
      (rejected.native.length === 0
        ? ""
        : `Found other Node interpreters, but none of them could load this package's better-sqlite3, ` +
          `which is built for one Node ABI: ${rejected.native.join(", ")}.\n` +
          `Run the command under the Node that installed the dependencies, or rebuild them for one of these.\n`) +
      `Install a safe one: nvm install ${String(PIN.major)} \u2014 then run the command again.\n` +
      `Looked for one in AGENT_FLOWS_NODE, on PATH, under ${join(nvmDir, "versions", "node")}, /opt/homebrew/bin/node and /usr/local/bin/node.\n`
  );
  process.exit(1);
}

/** Re-exec this CLI under a compatible node, or refuse with the reason. */
function reExecOrRefuse() {
  // Already re-execed once and still too old: the interpreter we picked was not
  // what it claimed to be. Refuse rather than fork forever.
  const alreadyReExeced = process.env[REEXEC_MARKER] !== undefined;
  const rejected = { native: [], belowFloor: [] };
  if (!alreadyReExeced) {
    const override = process.env.AGENT_FLOWS_NODE;
    if (override !== undefined && override !== "") reExec(overrideInterpreter(override));
    const candidate = findInterpreter(rejected);
    if (candidate !== undefined) reExec(candidate);
  }
  refuse(rejected);
}

/** Run this same script under `binary`, forwarding everything, and exit with it. */
function reExec(binary) {
  const result = spawnSync(binary, [process.argv[1], ...process.argv.slice(2)], {
    stdio: "inherit",
    env: { ...process.env, [REEXEC_MARKER]: "1" },
  });
  if (result.error !== undefined && result.error !== null) {
    process.stderr.write(`agent-flows: could not run ${binary}: ${result.error.message}\n`);
    process.exit(1);
  }
  if (result.signal !== null && result.signal !== undefined) {
    process.kill(process.pid, result.signal);
  }
  process.exit(result.status ?? 1);
}

const cliPath = join(root, "dist", "cli.js");
if (!existsSync(cliPath)) {
  process.stderr.write(
    `agent-flows: the compiled CLI is missing at ${cliPath}.\n` +
      `This is a source checkout without a build — run "pnpm build" first.\n`
  );
  process.exit(1);
}

await import(cliPath);
